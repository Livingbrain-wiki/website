# Cloudflare Pages response headers.
# CSS and JS are referenced with a ?v=<content hash> stamped by
# tools/build-dist.sh, so the URL changes whenever the file does.
#
# The CSP allows one inline script: the theme snippet at the top of <head> in
# index.html and 404.html, by its sha256. If you change that snippet, update the
# hash here (tools/build-dist.sh checks it). connect-src allows the waitlist
# Worker; form-action allows the no-JavaScript mailto fallback.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qpDpmxumUmYETegZxYiLwu1Qll9Xo7JOHZ/KulV5Ydw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.livingbrain.wiki; manifest-src 'self'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=604800

/assets/*.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
